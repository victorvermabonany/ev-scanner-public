{
  "name": "chess-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Chess Coach web app",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "games": "npm --prefix server run games --",
    "analyze": "npm --prefix server run analyze --",
    "build": "npm --prefix client run build",
    "build:pages": "npm run build && rm -rf ../chess && cp -r client/dist ../chess",
    "preview": "npm --prefix client run preview",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "report": "npm --prefix server run report --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "chess.js": "^1.4.0"
  }
}
